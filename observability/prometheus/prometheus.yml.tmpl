global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/alerts.yml

scrape_configs:
  - job_name: backend
    metrics_path: /metrics
    static_configs:
      - targets: ["app:3000"]

  # FreeRADIUS Status-Server exporter (published on host :9812 by radius-docker-image)
  - job_name: freeradius
    metrics_path: /metrics
    static_configs:
      - targets: ["host.docker.internal:9812"]

remote_write:
  - url: __PROM_REMOTE_WRITE_URL__
