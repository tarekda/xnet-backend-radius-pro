{
  "name": "xnet-backend-radius-pro",
  "version": "1.5.4",
  "description": "",
  "main": "server.js",
  "scripts": {
    "test": "jest",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon",
    "typeorm:generate": "typeorm migration:generate -n",
    "typeorm:run": "typeorm migration:run",
    "typeorm:revert": "typeorm migration:revert",
    "typeorm": "typeorm",
    "migrations:run": "typeorm-ts-node-commonjs migration:run -d ./src/db/config.ts",
    "migrations:show": "typeorm-ts-node-commonjs migration:show -d ./src/db/config.ts",
    "migrations:revert": "typeorm-ts-node-commonjs migration:revert -d ./src/db/config.ts",
    "migrations:run:dist": "npm run build && typeorm migration:run -d ./dist/db/config.js",
    "migrations:show:dist": "npm run build && typeorm migration:show -d ./dist/db/config.js",
    "migrations:revert:dist": "npm run build && typeorm migration:revert -d ./dist/db/config.js",
    "typeorm:entity:generate": "npm run typeorm -- entity:create",
    "generate-entities": "npm run typeorm -- -d src/db/config.ts entity:create /src/entities",
    "generate:entities": "typeorm-model-generator -h localhost -d radius -u radius -x password -e mysql -o ./outputEntities",
    "docker:build": "docker build --no-cache -t xnet-backend-radius-pro .",
    "docker:run": "docker run -p 3000:3000 --env-file .env xnet-backend-radius-pro",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up",
    "docker:dev:stop": "docker-compose -f docker-compose.dev.yml down",
    "docker:prod:build": "docker-compose -f docker-compose.yml build",
    "docker:prod:up": "docker-compose -f docker-compose.yml up -d --build",
    "docker:prod:down": "docker-compose -f docker-compose.yml down",
    "docker:stop": "docker-compose -f docker-compose.yml down",
    "docker:logs": "docker-compose logs -f",
    "docker:clean": "docker system prune -f",
    "win:dev": "powershell -ExecutionPolicy Bypass -File .\\\\scripts\\\\dev.ps1",
    "win:docker:dev": "powershell -ExecutionPolicy Bypass -File .\\\\scripts\\\\docker-dev.ps1",
    "win:docker:prod": "powershell -ExecutionPolicy Bypass -File .\\\\scripts\\\\docker-prod.ps1",
    "win:docker:down": "powershell -ExecutionPolicy Bypass -File .\\\\scripts\\\\docker-down.ps1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@clickhouse/client": "^1.16.0",
    "@gavinaiken/netflowv9": "^1.3.1",
    "amqplib": "^0.10.5",
    "axios": "^1.9.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "express-winston": "^4.2.0",
    "helmet": "^8.0.0",
    "https": "^1.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "mysql2": "^3.12.0",
    "node-cron": "^4.6.0",
    "node-routeros": "^1.6.8",
    "otplib": "12.0.1",
    "ping": "^0.4.4",
    "prom-client": "^15.1.3",
    "radius": "^1.1.4",
    "redis": "^4.7.0",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tesseract.js": "^7.0.0",
    "twilio": "^5.10.0",
    "ws": "^8.18.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-rate-limit": "^5.1.3",
    "@types/express-winston": "^3.0.4",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.15.32",
    "@types/ping": "^0.4.4",
    "@types/radius": "^0.0.33",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typeorm": "^0.3.20"
  }
}
